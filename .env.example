# Root .env — used by docker-compose to inject secrets into containers.
# Copy this file to .env and fill in REAL values. Never commit .env.

# ── JWT Secrets (use strong random strings, min 64 chars) ────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_64_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STRONG_RANDOM_SECRET_MIN_64_CHARS

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# ── MongoDB Auth (for Docker container) ──────────────────────────────────────
MONGO_ROOT_USER=foodflow
MONGO_ROOT_PASS=REPLACE_WITH_STRONG_MONGO_PASSWORD

# ── MongoDB (if using Atlas instead of Docker container) ──────────────────────
# MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/food_redistribution
