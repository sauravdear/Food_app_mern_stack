NODE_ENV=production

PORT=5000

# MongoDB Atlas URI — replace with your actual Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?appName=Cluster0

# JWT — MUST be strong random strings (min 64 chars) in production
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STRONG_RANDOM_SECRET
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# SMTP — use a Gmail App Password, NOT your real Gmail password
# Enable 2FA on Gmail → https://myaccount.google.com/security
# Then create App Password → https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=FoodFlow System

# Frontend URL (no trailing slash)
FRONTEND_URL=https://yourdomain.com

# Rate limiting for auth endpoints
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5
