# Copy this to .env.local for local development
# For Vercel production — set these in Vercel Dashboard > Settings > Environment Variables

# Full backend API URL including /api suffix
VITE_API_URL=https://your-render-app.onrender.com/api

# Backend root URL (no /api) — used for Socket.io connection
VITE_BACKEND_URL=https://your-render-app.onrender.com
